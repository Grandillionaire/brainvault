# Frontend Development Server
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001/ws

# Backend Server
PORT=3001
# Bind address. Loopback by default - only change this together with AUTH_REQUIRED
HOST=127.0.0.1
DB_PATH=./data/brainvault.db
VAULT_PATH=./data/vault
ATTACHMENTS_PATH=./data/attachments

# AI/Ollama Configuration (optional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:1420,http://localhost:5173

# JWT Secret (for multi-user setup)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS

# Require a valid JWT on every notes/search/settings/ai/attachment endpoint.
# Off by default for the single-user loopback setup; MUST be true for any
# deployment reachable from outside this machine.
AUTH_REQUIRED=false

# Environment
NODE_ENV=development
